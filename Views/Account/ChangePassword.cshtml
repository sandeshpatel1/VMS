@model ChangePasswordVM
@{ ViewData["Title"] = "Change password"; }
<div class="page-head"><h1>Change password</h1></div>
<form asp-action="ChangePassword" method="post" class="card form narrow">
    <div asp-validation-summary="ModelOnly" class="form-error"></div>
    <div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
    <div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span><small class="hint">8 or more characters, with a letter and a number.</small></div>
    <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
    <div class="actions"><button class="btn primary" type="submit">Save password</button><a class="btn ghost" asp-controller="Home" asp-action="Index">Cancel</a></div>
</form>
