@model PreApprovalVM
@{
    ViewData["Title"] = "Add pre-approval";
    var isResident = User.IsInRole(Roles.Resident);
}
<div class="page-head"><h1>Add pre-approval</h1></div>
<form asp-action="Create" method="post" class="card form wide">
    <div asp-validation-summary="ModelOnly" class="form-error"></div>
    @if (!isResident)
    {
        <div class="field">
            <label asp-for="ResidentId"></label>
            <label class="search">@Html.Icon("search")<input type="search" data-filter-select="#ResidentId" placeholder="Type a flat number or name to narrow the list" aria-label="Filter residents" /></label>
            <select asp-for="ResidentId" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Residents)"><option value="">Select resident</option></select>
            <span asp-validation-for="ResidentId"></span>
        </div>
    }
    <div class="two">
        <div class="field"><label asp-for="VisitorName"></label><input asp-for="VisitorName" autocomplete="off" placeholder="Enter visitor name" /><span asp-validation-for="VisitorName"></span></div>
        <div class="field"><label asp-for="Mobile"></label><input asp-for="Mobile" type="tel" inputmode="numeric" maxlength="10" autocomplete="off" placeholder="10-digit mobile number" /><span asp-validation-for="Mobile"></span></div>
    </div>
    <div class="field">
        <label asp-for="Category"></label>
        <select asp-for="Category" asp-items="@(new SelectList(Lists.PreCategories))"><option value="">Select category</option></select>
        <span asp-validation-for="Category"></span>
    </div>
    <div class="two">
        <div class="field"><label asp-for="ValidFrom"></label><input asp-for="ValidFrom" type="datetime-local" /><span asp-validation-for="ValidFrom"></span></div>
        <div class="field"><label asp-for="ValidTill"></label><input asp-for="ValidTill" type="datetime-local" /><span asp-validation-for="ValidTill"></span></div>
    </div>
    <label class="check"><input asp-for="IsRecurring" type="checkbox" /> @Html.DisplayNameFor(m => m.IsRecurring)</label>
    <small class="hint">A 6-digit access code is created for the visitor. Security can also find the entry by name or flat.</small>
    <div class="actions"><button class="btn primary" type="submit">Save pre-approval</button><a class="btn ghost" asp-action="Index">Cancel</a></div>
</form>
