@{
    ViewData["Title"] = "Reports";

    var purposes = (string[])ViewBag.Purposes;

    var statuses = (string[])ViewBag.Statuses;

    var flats = (List<string>)ViewBag.Flats;

    var staff = (List<SelectListItem>)ViewBag.Staff;

    var presets = new (string Key, string Text)[]

    {
        ("today", "Today"), ("7d", "7 days"), ("30d", "30 days"), ("month", "This month"),
        ("lastmonth", "Last month"), ("90d", "90 days"), ("custom", "Custom")

    };
}
<div class="page-head">
    <div>
        <h1>Reports</h1>
        <p class="sub" id="rpRange">Loading...</p>
    </div>
    <div class="actions" style="margin:0">
        <a class="btn ghost" id="rpExport" href="@Url.Action("Export")">@Html.Icon("download")Export CSV</a>
        <button class="btn ghost" type="button" id="rpPrint">@Html.Icon("printer")Print</button>
    </div>
</div>

<section class="card rp-filters" aria-label="Report filters">
    <div class="rp-presets" role="group" aria-label="Date range">
        @foreach (var pr in presets)

        {
            <button type="button" data-preset="@pr.Key" aria-pressed="false">@pr.Text</button>
        }
    </div>
    <div class="rp-custom" id="rpCustom" hidden>
        <div class="field"><label for="rpFrom">From</label><input id="rpFrom" type="date" /></div>
        <div class="field"><label for="rpTo">To</label><input id="rpTo" type="date" /></div>
    </div>
    <div class="rp-selects">
        <div class="field">
            <label for="rpPurposeSel">Purpose</label>
            <select id="rpPurposeSel" data-f="purpose"><option value="">All purposes</option>@foreach (var x in purposes)
                {
                    <option value="@x">@x</option>
                }</select>
        </div>
        <div class="field">
            <label for="rpStatusSel">Status</label>
            <select id="rpStatusSel" data-f="status"><option value="">All statuses</option>@foreach (var x in statuses)
                {
                    <option value="@x">@Ui.StatusLabel(x)</option>
                }</select>
        </div>
        <div class="field">
            <label for="rpFlatSel">Flat</label>
            <select id="rpFlatSel" data-f="flat"><option value="">All flats</option>@foreach (var x in flats)
                {
                    <option value="@x">@x</option>
                }</select>
        </div>
        <div class="field">
            <label for="rpStaffSel">Logged by</label>
            <select id="rpStaffSel" data-f="loggedBy"><option value="">Everyone</option>@foreach (var x in staff)
                {
                    <option value="@x.Value">@x.Text</option>
                }</select>
        </div>
        <div class="field">
            <label for="rpSearch">Search</label>
            <input id="rpSearch" type="search" data-f="q" placeholder="Name, mobile or visitor ID" autocomplete="off" />
        </div>
    </div>
    <div class="rp-bar">
        <label class="check"><input type="checkbox" id="rpCompare" checked /> Compare with the previous period</label>
        <div class="rp-chips" id="rpChips" aria-label="Active filters"></div>
        <button type="button" class="btn ghost sm" id="rpReset">Reset filters</button>
    </div>
</section>

<div id="rpApp" data-url="@Url.Action("Data")" data-export="@Url.Action("Export")" data-details="@Url.Action("Details", "Visitors")" aria-live="polite">
    <p class="rp-error" id="rpError" role="alert" hidden></p>
    <section class="rp-kpis" id="rpKpis" aria-label="Headline numbers"></section>

    <section class="rp-grid">
        <article class="card rp-wide">
            <header class="rp-h"><h2>Visitors over time</h2><span class="hint" id="rpGran"></span></header>
            <div id="rpLine" class="rp-line"></div>
        </article>
        <article class="card"><header class="rp-h"><h2>By purpose</h2><span class="hint">Select a bar to filter</span></header><div id="rpPurpose"></div></article>
        <article class="card"><header class="rp-h"><h2>Visit funnel</h2><span class="hint">From the gate to checkout</span></header><div id="rpFunnel"></div></article>
        <article class="card rp-wide"><header class="rp-h"><h2>When visitors arrive</h2><span class="hint">Day of week by hour</span></header><div id="rpHeat" class="rp-heat"></div></article>
        <article class="card"><header class="rp-h"><h2>Busiest flats</h2><span class="hint">Select a flat to filter</span></header><div id="rpFlats"></div></article>
        <article class="card"><header class="rp-h"><h2>Average stay</h2><span class="hint">By purpose</span></header><div id="rpStay"></div></article>
        <article class="card"><header class="rp-h"><h2>Repeat visitors</h2><span class="hint">Select one to see all visits</span></header><div id="rpRepeat"></div></article>
        <article class="card"><header class="rp-h"><h2>Security desk</h2><span class="hint">Entries logged by</span></header><div id="rpStaff"></div></article>
        <article class="card"><header class="rp-h"><h2>Deliveries and alerts</h2></header><div id="rpOther"></div></article>
    </section>

    <section class="card rp-table">
        <header class="rp-h">
            <h2>All visits <span class="hint" id="rpCount"></span></h2>
            <label class="search rp-tsearch">@Html.Icon("search")<input type="search" id="rpTableSearch" placeholder="Search these results" aria-label="Search these results" /></label>
        </header>
        <div class="table-wrap">
            <table id="rpTable">
                <thead>
                    <tr>
                        <th data-sort="code">ID</th>
                        <th data-sort="name">Visitor</th>
                        <th data-sort="flat">Flat</th>
                        <th data-sort="purpose">Purpose</th>
                        <th data-sort="status">Status</th>
                        <th data-sort="created">Registered</th>
                        <th data-sort="inTime">In</th>
                        <th data-sort="outTime">Out</th>
                        <th data-sort="stay">Stay</th>
                        <th data-sort="loggedBy">Logged by</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="rp-pager"><span class="hint" id="rpPageInfo"></span><div><button type="button" class="btn ghost sm" id="rpPrev">Previous</button> <button type="button" class="btn ghost sm" id="rpNext">Next</button></div></div>
    </section>
</div>

<div class="rp-tip" id="rpTip" hidden></div>

@section Scripts {
     <script src="~/js/reports.js" asp-append-version="true"></script>
}
