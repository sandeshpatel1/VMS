@inject AppDbContext Db
@{
    var authed = User.Identity?.IsAuthenticated == true;

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var unread = 0;

    var emergency = false;

    var role = "";

    if (authed)

    {

        var uid = User.UserId();

        unread = await Db.Notifications.CountAsync(n => n.UserId == uid && !n.IsRead);

        emergency = await Db.Emergencies.AnyAsync(e => !e.IsResolved);

        role = User.IsInRole(Roles.Admin) ? Roles.Admin : User.IsInRole(Roles.Watchman) ? Roles.Watchman : Roles.Resident;

    }

    var userName = User.Identity?.Name ?? "";

    var isStaff = role == Roles.Admin || role == Roles.Watchman;

    string On(string c, string? a = null) => controller == c && (a == null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#EDF1F9" />
    <meta name="color-scheme" content="light dark" />
    <script>
        (function () {
            try {
                var t = localStorage.getItem('dwaarix-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.dataset.theme = t;
                if (localStorage.getItem('dwaarix-rail') === '1') document.documentElement.dataset.rail = '1';
            } catch (e) { document.documentElement.dataset.theme = 'light'; }
        })();
    </script>
    <title>@ViewData["Title"] - Dwaarix</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(authed ? "app" : "bare")">
    <partial name="_Sprite" />
    <div class="ambient" aria-hidden="true"><i></i><i></i><i></i></div>
    @if (authed)

    {
        <div class="shell">
            <div class="scrim" data-close-drawer></div>
            <aside class="side" id="drawer" aria-label="Main navigation">
                <div class="side-head">
                    <a class="brand" asp-controller="Home" asp-action="Index" title="Dwaarix"><span class="brand-mark">D</span><span class="label">Dwaarix</span></a>
                    <button class="rail-btn" type="button" data-rail-toggle aria-pressed="false" aria-label="Collapse sidebar" title="Collapse sidebar">
                        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><polyline points="11 17 6 12 11 7" /><polyline points="18 17 13 12 18 7" /></svg>
                    </button>
                </div>

                <nav class="nav">
                    <a class="@On("Home")" title="Dashboard" asp-controller="Home" asp-action="Index">@Html.Icon("home")<span class="label">Dashboard</span></a>

                    <div class="nav-group"><span>Visitors</span></div>
                    @if (isStaff)
                    {
                        <a class="@On("Visitors", "Create")" title="New visitor" asp-controller="Visitors" asp-action="Create">@Html.Icon("user-plus")<span class="label">New visitor</span></a>
                    }
                    <a class="@(controller == "Visitors" && action != "Create" ? "active" : "")" title="Visitor history" asp-controller="Visitors" asp-action="Index">@Html.Icon("clock")<span class="label">Visitor history</span></a>
                    <a class="@On("PreApprovals")" title="Pre-approved" asp-controller="PreApprovals" asp-action="Index">@Html.Icon("check-square")<span class="label">Pre-approved</span></a>
                    <a class="@On("Deliveries")" title="Deliveries" asp-controller="Deliveries" asp-action="Index">@Html.Icon("truck")<span class="label">Deliveries</span></a>

                    <div class="nav-group"><span>Community</span></div>
                    @if (isStaff)
                    {
                        <a class="@On("Residents")" title="Resident directory" asp-controller="Residents" asp-action="Index">@Html.Icon("book")<span class="label">Resident directory</span></a>
                    }
                    <a class="@On("Emergency")" title="Emergency" asp-controller="Emergency" asp-action="Index">@Html.Icon("alert")<span class="label">Emergency</span></a>
                    <a class="@On("Notifications")" title="Notifications" asp-controller="Notifications" asp-action="Index">@Html.Icon("bell")<span class="label">Notifications</span> @if (unread > 0)
                        {
                            <span class="badge">@unread</span>
                        }</a>

                    @if (role == Roles.Admin)
                    {
                        <div class="nav-group"><span>Administration</span></div>
                        <a class="@On("Users")" title="Users and roles" asp-controller="Users" asp-action="Index">@Html.Icon("shield")<span class="label">Users and roles</span></a>
                        <a class="@On("Reports")" title="Reports" asp-controller="Reports" asp-action="Index">@Html.Icon("chart")<span class="label">Reports</span></a>
                    }
                </nav>

                <div class="me">
                    <div class="me-row">
                        <span class="me-chip" aria-hidden="true">@Ui.Initials(userName)</span>
                        <div class="me-text"><strong>@userName</strong><small>@role</small></div>
                    </div>
                    <div class="me-actions">
                        <a class="me-btn" title="Change password" asp-controller="Account" asp-action="ChangePassword">@Html.Icon("key")<span class="label">Password</span></a>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="me-btn" type="submit" title="Sign out">@Html.Icon("log-out")<span class="label">Sign out</span></button></form>
                    </div>
                </div>
            </aside>

            <header class="appbar">
                <button class="icon-btn menu-btn" type="button" data-open-drawer aria-label="Open menu">@Html.Icon("menu")</button>
                <div class="appbar-title">@(ViewData["Title"] ?? "Dwaarix")</div>
                <partial name="_ThemeToggle" />
                <a class="icon-btn" asp-controller="Notifications" asp-action="Index" data-tray-toggle aria-haspopup="dialog" aria-expanded="false" aria-controls="notifTray" aria-label="Notifications">@Html.Icon("bell") @if (unread > 0)
                    {
                        <span class="dot"></span>
                    }</a>
                <span class="me-chip" title="@userName" aria-hidden="true">@Ui.Initials(userName)</span>
            </header>
            <div class="tray" id="notifTray" role="dialog" aria-label="Notifications" data-url="@Url.Action("Tray", "Notifications")" hidden></div>

            <main class="main" id="main">
                @if (emergency)

                {
                    <a class="sos" asp-controller="Emergency" asp-action="Index">@Html.Icon("alert")An emergency alert is active. Tap to see details.</a>
                }
                @if (TempData["Success"] is string ok)

                {
                    <div class="toast ok" role="status">@Html.Icon("check")@ok</div>
                }
                @if (TempData["Error"] is string err)

                {
                    <div class="toast bad" role="alert">@Html.Icon("alert")@err</div>
                }
                @RenderBody()
            </main>

            <nav class="tabbar" aria-label="Quick navigation">
                <a class="@On("Home")" asp-controller="Home" asp-action="Index">@Html.Icon("home")<span>Home</span></a>
                <a class="@(controller == "Visitors" && action != "Create" ? "active" : "")" asp-controller="Visitors" asp-action="Index">@Html.Icon("clock")<span>Visitors</span></a>
                @if (isStaff)

                {
                    <a class="tab-main @On("Visitors", "Create")" asp-controller="Visitors" asp-action="Create" aria-label="New visitor">@Html.Icon("plus")</a>
                }

                else

                {
                    <a class="tab-main @On("PreApprovals", "Create")" asp-controller="PreApprovals" asp-action="Create" aria-label="Pre-approve a visitor">@Html.Icon("plus")</a>
                }
                <a class="@On("Notifications")" asp-controller="Notifications" asp-action="Index">@Html.Icon("bell")<span>Alerts</span> @if (unread > 0)
                    {
                        <i class="dot"></i>
                    }</a>
                <button type="button" data-open-drawer>@Html.Icon("menu")<span>More</span></button>
            </nav>
        </div>
    }

    else

    {
        <div class="bare-tools"><partial name="_ThemeToggle" /></div>
        <main class="bare-main">@RenderBody()</main>
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
